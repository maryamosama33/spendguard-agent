GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
# Hermes's chat model (Groq). SpendGuard itself only uses Gemini, for invoice reading.
GROQ_API_KEY=
# Telegram bot (optional): token from @BotFather, comma-separated numeric user
# IDs allowed to use it, and the owner's chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
# Numeric Telegram user IDs of the owner(s): only they can approve/reject
# expenses and use the bot's /commands, and engineers' requests are sent to
# their chats. Leave empty to not restrict.
SPENDGUARD_OWNER_IDS=
